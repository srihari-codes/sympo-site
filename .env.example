# ─────────────────────────────────────────────────────────────
# docker-compose environment  ·  copy to .env and fill in
# ─────────────────────────────────────────────────────────────

# Public hostname this stack is served on (used for TLS + certbot).
# Use "localhost" for local docker testing.
DOMAIN=localhost

# ── Backend secrets ──
JWT_SECRET=change_me_to_a_long_random_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── Frontend build-time config ──
# Baked into the JS bundle by Vite. Must match GOOGLE_CLIENT_ID's project and
# have https://DOMAIN listed as an Authorized JavaScript origin in Google Cloud.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Let's Encrypt (only needed for: docker compose --profile ssl run --rm certbot) ──
CERTBOT_EMAIL=admin@example.com
