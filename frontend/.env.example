# Frontend — local (non-Docker) dev. Copy to frontend/.env
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# API origin. Empty = same-origin (prod behind nginx). For local dev leave empty
# and let the Vite proxy forward /api and /uploads to the backend.
VITE_API_BASE=

# Where the Vite dev proxy sends /api and /uploads (local dev only).
VITE_API_TARGET=http://localhost:5050
