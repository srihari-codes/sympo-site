# Backend — local (non-Docker) dev. Copy to backend/.env
PORT=5050
NODE_ENV=development
JWT_SECRET=dev_jwt_secret_change_me
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Emails allowed into /admin (comma-separated)
ADMIN_EMAILS=you@example.com

# Optional overrides (Docker sets these):
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# Email (Brevo SMTP) — required for registration confirmation emails
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="Zyverse 2K26 <admin@whitehatians.in>"
